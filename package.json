    "date-fns": "^4.1.0",
    "expo": "~52.0.0",
    "expo-asset": "^55.0.16",
    "expo-constants": "~17.0.0",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.0",
    "expo-linear-gradient": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
